{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gtavi",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "runeball.no/GTAVI*", "zone_name": "runeball.no" },
    { "pattern": "runeball.no/gtavi*", "zone_name": "runeball.no" },
    { "pattern": "runeball.no/robots.txt", "zone_name": "runeball.no" },
    { "pattern": "runeball.no/sitemap.xml", "zone_name": "runeball.no" },
    { "pattern": "runeball.no/llms.txt", "zone_name": "runeball.no" }
  ],
  "workers_dev": false
}
